# Postgres connection string. Create the database first, e.g.:
#   createdb value_consultancy
DATABASE_URL="postgresql://USER@localhost:5432/value_consultancy?schema=public"

# Optional: enable AI "starter text" / smart-assist generation for deliverable sections.
# Without it the app still runs; AI-assist buttons fall back to the static template library.
ANTHROPIC_API_KEY=""

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
