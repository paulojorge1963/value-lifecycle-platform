# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Local: one Postgres, both URLs the same. Create the DB first: createdb value_consultancy
# Production (Vercel + Neon): DATABASE_URL = the POOLED connection (…-pooler…, serverless-safe),
#                             DIRECT_URL   = the DIRECT connection (for `prisma db push` / migrations).
DATABASE_URL="postgresql://USER@localhost:5432/value_consultancy?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/value_consultancy?schema=public"

# ── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
AUTH_SECRET=""          # generate: openssl rand -base64 32
AUTH_TRUST_HOST=true    # required behind Vercel's proxy

# ── Optional: AI assist ─────────────────────────────────────────────────────
# Without it the app still runs; AI-assist buttons fall back to the static template library.
ANTHROPIC_API_KEY=""

# ── Demo accounts ───────────────────────────────────────────────────────────
# Shared password for the seeded demo accounts. `npm run db:seed` hashes it, and
# the login page reads the same value for one-click demo sign-in. Leave it unset
# and the seed generates a random password and prints it (one-click is then off).
# Set it (e.g. for a local demo) to pick a stable password and enable one-click.
DEMO_PASSWORD=""

# ── Login member picker ─────────────────────────────────────────────────────
# The "pick a workspace → pick a member" login list is ON in dev and OFF in
# production (so member names/emails aren't exposed on a public deployment).
# Set to "true" to show it in production too.
SHOW_LOGIN_MEMBER_PICKER=""
